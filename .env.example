# Render PostgreSQL (Render uses postgres://; the app normalizes it for SQLAlchemy).
DATABASE_URL=postgresql+psycopg2://user:password@host:5432/ma_db

# Comma-separated frontend URLs for production CORS.
FRONTEND_ORIGINS=https://ma-two-pearl.vercel.app
ALLOW_ALL_ORIGINS=false
ENVIRONMENT=production

# Local development:
# ENVIRONMENT=development
# ALLOW_ALL_ORIGINS=true
# FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/ma_db

# Optional Vercel preview deploy support when ALLOW_ALL_ORIGINS=false.
FRONTEND_ORIGIN_REGEX=^https?://([a-z0-9-]+\.vercel\.app|localhost|127\.0\.0\.1)(:\d+)?$

# Auth
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional local fallback when DATABASE_URL is not set and ENVIRONMENT is not production.
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
# DB_DATABASE=ma_db
