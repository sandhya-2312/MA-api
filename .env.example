# Required PostgreSQL connection string.
# Render provides postgres:// URLs; the app normalizes them for SQLAlchemy/psycopg2.
DATABASE_URL=postgresql+psycopg2://user:password@host:5432/ma_db

# Comma-separated frontend URLs for production CORS.
FRONTEND_ORIGINS=https://ma-two-pearl.vercel.app
ALLOW_ALL_ORIGINS=false
ENVIRONMENT=production

# Local development:
# ENVIRONMENT=development
# ALLOW_ALL_ORIGINS=true
# FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/ma_db

# Optional Vercel preview deploy support when ALLOW_ALL_ORIGINS=false.
FRONTEND_ORIGIN_REGEX=^https?://([a-z0-9-]+\.vercel\.app|localhost|127\.0\.0\.1)(:\d+)?$

# Auth
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Deployment login accounts (created only when the username does not already exist).
# Existing users keep their stored passwords and role dashboards after redeploy.
# INITIAL_ADMIN_USERNAME=Sandhya
# INITIAL_ADMIN_PASSWORD=replace-with-admin-password
# INITIAL_USER_USERNAME=user1
# INITIAL_USER_PASSWORD=replace-with-user-password
# INITIAL_VIEWER_USERNAME=Viewer1
# INITIAL_VIEWER_PASSWORD=replace-with-viewer-password
# INITIAL_ADMIN_FIRST_LOGIN=false
# INITIAL_USER_FIRST_LOGIN=false
# INITIAL_VIEWER_FIRST_LOGIN=false

# Copy existing local data into production when needed:
# SOURCE_DATABASE_URL=postgresql://...
# TARGET_DATABASE_URL=postgresql://...
# python -m scripts.copy_application_data

# DATABASE_CONNECT_TIMEOUT=10
# DATABASE_POOL_TIMEOUT=30
# DATABASE_POOL_RECYCLE=300
# DATABASE_POOL_SIZE=5
# DATABASE_MAX_OVERFLOW=2
# DATABASE_STARTUP_RETRIES=5
# DATABASE_STARTUP_RETRY_DELAY_SECONDS=3
# DATABASE_SSLMODE=require
